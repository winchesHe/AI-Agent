{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/hello-agent/specs/004-openclaw-alignment/health-snapshot.schema.json",
  "title": "HealthSnapshot",
  "type": "object",
  "required": ["status", "checks"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "degraded", "unhealthy"]
    },
    "uptime_seconds": { "type": "number", "minimum": 0 },
    "loaded_plugins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
